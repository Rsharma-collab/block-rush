rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'playerName', 'score', 'distance', 'gCores', 'maxCombo', 'eventsSurvived', 'avatar', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'playerName', 'score', 'distance', 'gCores', 'maxCombo', 'eventsSurvived', 'avatar', 'createdAt']) &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 30 &&
        data.score is number && data.score >= 0 && data.score <= 100000000 &&
        data.distance is number && data.distance >= 0 && data.distance <= 100000000 &&
        data.gCores is number && data.gCores >= 0 && data.gCores <= 1000000 &&
        data.maxCombo is number && data.maxCombo >= 1 && data.maxCombo <= 100 &&
        data.eventsSurvived is number && data.eventsSurvived >= 0 && data.eventsSurvived <= 10000 &&
        data.avatar is string && data.avatar.size() <= 32 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /leaderboard/{entryId} {
      // Anyone can view the leaderboard scores
      allow get, list: if true;

      // Only signed-in players can post their own validated high score record
      allow create: if isSignedIn() && isValidId(entryId) && isValidLeaderboardEntry(incoming());

      // Scores are immutable once recorded to protect leaderboard integrity
      allow update: if false;

      // Players may delete their own submitted scores if they wish
      allow delete: if isSignedIn() && isValidId(entryId) && existing().userId == request.auth.uid;
    }
  }
}
